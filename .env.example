# ─────────────────────────────────────────────────────────────────────
# Copia este archivo como .env y rellena los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).
# En producción, estos mismos valores se pegan en EasyPanel.
# ─────────────────────────────────────────────────────────────────────

# Supabase — Project Settings > API
# La service_role key es la llave maestra: solo vive aquí, jamás en el panel.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Quién puede usar el API. Correos separados por coma.
ADMIN_EMAILS=alekhammer13@gmail.com

# Desde qué sitios se acepta una llamada. Separados por coma.
ORIGENES_PERMITIDOS=https://adlek.com.mx,http://localhost:3000

# OpenAI — los 5 agentes de texto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Perplexity — la investigación. Si se deja vacío, el sistema funciona
# igual pero con el switch "Investigar en internet" apagado.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# Replicate — las imágenes de apoyo. Si se deja vacío, el botón de
# generar imágenes queda deshabilitado en el panel.
REPLICATE_API_TOKEN=
REPLICATE_MODELO=minimax/image-01

# Límites. Existen para que esto no se gaste tu dinero por accidente.
MAX_GENERACIONES_ACTIVAS=2
MAX_IDEAS=10
MAX_CONCURRENCIA_LLM=4
REPLICATE_TIMEOUT_SEG=180
REPLICATE_MAX_INTENTOS=3

# Storage
BUCKET_IMAGENES=contenido-imagenes
